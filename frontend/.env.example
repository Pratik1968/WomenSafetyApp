# Optional. Overrides the backend URL in src/api/config.ts.
# Leave unset to use the emulator default (10.0.2.2:8000) / localhost.
# Useful for a physical device on the same LAN (http://<your-machine-LAN-IP>:8000/api/v1)
# or a deployed/staging backend.

# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000/api/v1
# Copy to `.env` and fill in from your Supabase project (Settings → API).
# EXPO_PUBLIC_* vars are inlined into the app at build time.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
