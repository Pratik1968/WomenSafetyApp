{
  "expo": {
    "name": "Aegis",
    "slug": "aegis-women-safety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090A0F",
        "foregroundImage": "./assets/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nameisrk.aegiswomensafety",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Aegis to access your contacts to select emergency contacts for SOS alerts."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Aegis to access your location in the background to monitor your journey and broadcast SOS coordinates even when your phone screen is locked.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications"
    ]
  }
}
